{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "-w",
        "@sparksocial/api"
      ],
      "port": 8080
    },
    {
      "//web": "Pinned to 3000, not autoPort: Clerk's dev instance authorises http://localhost:3000 (CLERK_AUTHORIZED_PARTIES) and the API's CORS allowlist matches it, so on any other port sign-in fails. Free the port rather than moving the app.",
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@sparksocial/web"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:verify",
        "-w",
        "@sparksocial/web"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "proto",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "ui build"
      ],
      "port": 4173
    }
  ]
}
