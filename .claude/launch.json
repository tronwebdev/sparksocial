{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@sparksocial/api"],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@sparksocial/web"],
      "port": 3000
    },
    {
      "name": "web-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:3001", "-w", "@sparksocial/web"],
      "port": 3001
    }
  ]
}
