##############################################################################
# SparkSocial web — environment
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so a
# change to any of them needs a dev-server restart, not just a refresh. Never
# put a secret behind a NEXT_PUBLIC_ prefix.
##############################################################################

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Keep protected-route redirects on the custom screens in (auth)/ rather than
# Clerk's hosted pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── API ─────────────────────────────────────────────────────────────────────
# Where the single tool proxy (src/app/api/tools/[name]/route.ts) forwards to.
SPARK_API_URL=http://localhost:8080

# ─── Social sign-in ──────────────────────────────────────────────────────────
# Must match what is actually enabled in Clerk → User & Authentication → Social
# Connections; a button for a provider the instance does not have is a dead
# control. Comma-separated: google,facebook,x
NEXT_PUBLIC_SOCIAL_PROVIDERS=google

# ─── Observability (browser side) ────────────────────────────────────────────
# Optional. No-ops when unset.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=phc_BYsLWYc98AYzKEmRAjTNKswnruDkMHf3iuaLap8r46r5
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
