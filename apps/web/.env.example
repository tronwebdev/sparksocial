NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Keep protected-route redirects on the custom screens in (auth)/ rather than
# Clerk's hosted pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where the tool proxy forwards to.
SPARK_API_URL=http://localhost:8080

# Social providers to show buttons for. Must match what is actually enabled in
# Clerk -> User & Authentication -> Social Connections; a button for a provider
# the instance does not have is a dead control. Comma-separated.
NEXT_PUBLIC_SOCIAL_PROVIDERS=google
