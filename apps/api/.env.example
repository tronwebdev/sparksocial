# Clerk. Without CLERK_SECRET_KEY the API falls back to the header-trusting dev
# resolver, and refuses to boot at all when NODE_ENV=production.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Origins allowed to mint tokens this API accepts — the audience check that stops
# a token issued for another Clerk application being replayed here. Comma-separated.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Azure Database for PostgreSQL. Unset → in-memory dev store seeded with the golden set.
DATABASE_URL=

# Local dev only: seeds the in-memory store under your real Clerk org id, so genome
# lookups resolve instead of 403-ing against a store that does contain the genome.
DEV_SEED_ORG_ID=

# Azure Blob Storage (managed identity in cloud, `az login` locally — no connection strings).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=assets
