{
  "name": "@sparksocial/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "//env": "`--env-file-if-exists` (Node >=20.12): local .env is how secrets reach dev without a shell export, and in Azure the values come from Key Vault via Container Apps env, where no file exists. The optional form makes one script correct in both, and in CI, which also has no .env.",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts"
  },
  "dependencies": {
