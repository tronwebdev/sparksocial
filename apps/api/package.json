    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.70.0",
    "@sparksocial/agency": "*",
    "@sparksocial/analytics": "*",
    "@sparksocial/assemble": "*",
    "@sparksocial/assetgraph": "*",
    "@sparksocial/campaign": "*",
    "@sparksocial/capture": "*",
    "@sparksocial/compose": "*",
    "@sparksocial/db": "*",
