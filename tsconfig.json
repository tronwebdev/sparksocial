{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sparksocial/shared/*": ["packages/shared/src/*"],
      "@sparksocial/shared": ["packages/shared/src/index.ts"],
      "@sparksocial/db/*": ["packages/db/src/*"],
      "@sparksocial/db": ["packages/db/src/index.ts"],
      "@sparksocial/tools/*": ["packages/tools/src/*"],
      "@sparksocial/tools": ["packages/tools/src/index.ts"],
      "@sparksocial/genome/*": ["packages/genome/src/*"],
      "@sparksocial/playbooks/*": ["packages/playbooks/src/*"],
      "@sparksocial/playbooks": ["packages/playbooks/src/index.ts"],
      "@sparksocial/assetgraph/*": ["packages/assetgraph/src/*"],
      "@sparksocial/assetgraph": ["packages/assetgraph/src/index.ts"],
      "@sparksocial/capture/*": ["packages/capture/src/*"],
      "@sparksocial/capture": ["packages/capture/src/index.ts"],
      "@sparksocial/guardrails/*": ["packages/guardrails/src/*"],
      "@sparksocial/guardrails": ["packages/guardrails/src/index.ts"],
      "@sparksocial/finish/*": ["packages/finish/src/*"],
      "@sparksocial/finish": ["packages/finish/src/index.ts"],
      "@sparksocial/spark/*": ["packages/spark/src/*"],
      "@sparksocial/spark": ["packages/spark/src/index.ts"],
      "@sparksocial/genome": ["packages/genome/src/index.ts"],
      "@/*": ["apps/web/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "apps/api/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/dist"]
}
